<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>xlsx2pdf</groupId>
  <artifactId>xlsx2pdf</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>xlsx2pdf</name>
  <description>Excel ブック (.xlsx) を、Excel の「PDF として保存」とほぼ同じレイアウトで PDF に変換する Java のツール</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <poi.version>5.5.1</poi.version>
    <pdfbox.version>3.0.8</pdfbox.version>
  </properties>

  <!-- POI が使うライブラリを最新の安定版に固定する (POI 5.5.1 の既定より新しい版) -->
  <dependencyManagement>
    <dependencies>
      <dependency><groupId>org.apache.xmlbeans</groupId><artifactId>xmlbeans</artifactId><version>5.4.1</version></dependency>
      <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.26.1</version></dependency>
      <dependency><groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><version>1.23.0</version></dependency>
      <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId><version>2.22.0</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-collections4</artifactId><version>4.6.0</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.21.0</version></dependency>
      <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.28.0</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml-full</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-scratchpad</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- 本ツールのライセンスを jar の直下に入れる -->
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <!-- 本体: 変換だけ (フォントは xlsx2pdf-fonts.jar に分ける) -->
          <execution>
            <id>release</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/xlsx2pdf.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>xlsx2pdf.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                    <Implementation-Title>xlsx2pdf</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <!-- 同じフォルダの同梱フォントの jar を自動で読む (なければ PC のフォントで代用) -->
                    <Class-Path>xlsx2pdf-fonts.jar</Class-Path>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <!-- 各ライブラリの LICENSE と NOTICE は上書きし合うので除き、META-INF/third-party にまとめたものを入れる -->
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                    <exclude>META-INF/DEPENDENCIES</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <!-- jar を小さくするため、xlsx の変換に使わない部分を除く (Word・PowerPoint・Outlook・Visio、電子署名) -->
                    <exclude>org/apache/poi/hwpf/**</exclude>
                    <exclude>org/apache/poi/hslf/**</exclude>
                    <exclude>org/apache/poi/hsmf/**</exclude>
                    <exclude>org/apache/poi/hdgf/**</exclude>
                    <exclude>org/apache/poi/hmef/**</exclude>
                    <exclude>org/apache/poi/hpbf/**</exclude>
                    <exclude>org/apache/poi/xdgf/**</exclude>
                    <exclude>org/apache/poi/poifs/crypt/dsig/**</exclude>
                    <exclude>org/openxmlformats/schemas/wordprocessingml/**</exclude>
                    <exclude>org/openxmlformats/schemas/presentationml/**</exclude>
                    <exclude>com/microsoft/schemas/office/word/**</exclude>
                    <exclude>com/microsoft/schemas/office/powerpoint/**</exclude>
                    <exclude>com/microsoft/schemas/office/visio/**</exclude>
                    <exclude>org/etsi/**</exclude>
                    <exclude>org/w3/x2000/x09/xmldsig/**</exclude>
                    <!-- 使わないライブラリの部分 (微分方程式・幾何・最適化・機械学習、pack200、発音の符号化) -->
                    <exclude>org/apache/commons/math3/ode/**</exclude>
                    <exclude>org/apache/commons/math3/geometry/**</exclude>
                    <exclude>org/apache/commons/math3/optim/**</exclude>
                    <exclude>org/apache/commons/math3/optimization/**</exclude>
                    <exclude>org/apache/commons/math3/genetics/**</exclude>
                    <exclude>org/apache/commons/math3/ml/**</exclude>
                    <exclude>org/apache/commons/math3/fitting/**</exclude>
                    <exclude>org/apache/commons/math3/filter/**</exclude>
                    <exclude>org/apache/commons/compress/harmony/**</exclude>
                    <exclude>org/apache/commons/codec/language/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>xlsx2pdf:xlsx2pdf</artifact>
                  <excludes>
                    <exclude>fonts/**</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <!-- 同梱フォント: 実フォントがない PC 用の代替フォントとライセンス文 (公開用の jar と同じフォルダに置く) -->
          <execution>
            <id>fonts</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/xlsx2pdf-fonts.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>xlsx2pdf:xlsx2pdf</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>xlsx2pdf:xlsx2pdf</artifact>
                  <includes>
                    <include>fonts/**</include>
                  </includes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
